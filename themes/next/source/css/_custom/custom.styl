// Local-first typography: a quiet sans-serif interface and a scholarly serif
// stack for long-form mathematical notes.
body
  font-family -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif

.post,
.post-body
  font-family "STIX Two Text", "Latin Modern Roman", "Times New Roman", "Noto Serif SC", "Songti SC", "STSong", serif
  font-size 16px
  line-height 1.68
  min-width 0
  overflow-wrap break-word

.post-title,
.post-title-link,
h1, h2, h3, h4, h5, h6
  font-family "STIX Two Text", "Latin Modern Roman", "Times New Roman", "Noto Serif SC", "Songti SC", "STSong", serif
  letter-spacing 0

.post-series
  margin-bottom .8em
  color #176d73
  font-family -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif
  font-size .78em
  font-weight 600
  letter-spacing .02em

.post-body p
  margin-top 0
  margin-bottom .72em

.post-body > p
  text-indent 2em

.post-body > p:has(> strong:first-child)
  margin 1em 0
  padding .7em 1em
  border-left 3px solid #238a8b
  background #eff9f1
  text-indent 0

.post-body h2
  margin-top 1.7em
  padding-top .45em
  border-top 2px solid #238a8b
  color #197b7c

.post-body h3
  margin-top 1.35em
  color #197b7c

.post-body blockquote
  font-family "STIX Two Text", "Latin Modern Roman", "Times New Roman", "Noto Serif SC", "Songti SC", "STSong", serif
  margin 1.1em 0
  padding .55em 1em
  border-left 3px solid #238a8b
  background #eef8f7
  line-height 1.62

.post-body blockquote p
  margin .3em 0
  text-indent 0

code,
pre,
.highlight
  font-family ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace

// Give display equations enough scale and whitespace to remain readable in
// long-form mathematical posts.
.post-body .MathJax_Display
  font-size 112%
  margin .55em 0 !important
  padding .02em 0
  max-width: 100%
  overflow-x: auto
  overflow-y: hidden
  box-sizing: border-box

// MathJax adds overflow to list items that contain inline formulas. Keep the
// list marker outside that clipping box so numbered explanations remain visible.
.post-body li.has-jax
  overflow: visible

.post-body .MathJax
  color #20252a

.algorithm-compare
  display table
  width 100%
  margin 1.2em 0 1.6em
  border-collapse collapse
  font-size .92em

.algorithm-compare th,
.algorithm-compare td
  padding .75em .8em
  border-bottom 1px solid #dfe5e2
  text-align left
  vertical-align top

.algorithm-compare th
  color #263337
  background #f6f8f7
  font-family -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Noto Sans SC", sans-serif
  font-size .86em

@media (max-width: 767px)
  .algorithm-compare
    display block
    overflow-x auto
    white-space nowrap
