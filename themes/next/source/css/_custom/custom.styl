// A book-like mathematical page: old-style Latin glyphs, Songti Chinese, and
// compact blocks modeled on printed lecture notes.
body
  font-family "Iowan Old Style", "Baskerville", "STIX Two Text", "TeX Gyre Pagella", "Noto Serif SC", "Songti SC", "STSong", serif
  font-variant-numeric oldstyle-nums

.post,
.post-body
  font-family "Iowan Old Style", "Baskerville", "STIX Two Text", "TeX Gyre Pagella", "Noto Serif SC", "Songti SC", "STSong", serif
  font-size 17px
  line-height 1.62
  min-width 0
  overflow-wrap break-word

.post-title,
.post-title-link,
h1, h2, h3, h4, h5, h6
  font-family "Iowan Old Style", "Baskerville", "STIX Two Text", "TeX Gyre Pagella", "Noto Serif SC", "Songti SC", "STSong", serif
  letter-spacing 0

.post-series
  margin-bottom .8em
  color #176d73
  font-family "Noto Serif SC", "Songti SC", "STSong", serif
  font-size .78em
  font-weight 600
  letter-spacing .02em

.post-body p
  margin-top 0
  margin-bottom .62em

.post-body > p
  text-indent 2em

.post-body > p:has(> strong:first-child)
  text-indent 0

.post-body h2
  text-align left
  margin-top 1.05em
  padding .42em 0 .3em
  border-top 2px solid #238a8b
  border-bottom 2px solid #238a8b
  color #197b7c

.lecture-chapter + h2
  margin-top .52em

.post-body h3
  text-align left
  margin-top 1.35em
  color #197b7c

.post-body blockquote
  font-family "Iowan Old Style", "Baskerville", "STIX Two Text", "TeX Gyre Pagella", "Noto Serif SC", "Songti SC", "STSong", serif
  margin 1.1em 0
  padding .55em 1em
  border-left 3px solid #238a8b
  background #eef8f7
  line-height 1.62

.post-body blockquote p
  margin .3em 0
  text-indent 0

code,
pre,
.highlight
  font-family ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace

// Give display equations enough scale and whitespace to remain readable in
// long-form mathematical posts.
.post-body .MathJax_Display
  font-size 112%
  margin .55em 0 !important
  padding .02em 0
  max-width: 100%
  overflow-x: auto
  overflow-y: hidden
  box-sizing: border-box

// MathJax adds overflow to list items that contain inline formulas. Keep the
// list marker outside that clipping box so numbered explanations remain visible.
.post-body li.has-jax
  overflow: visible

.post-body .MathJax
  color #20252a

// Printed-lecture blocks. They are reserved for definitions, theorems,
// examples, and notes; ordinary prose remains a continuous paragraph stream.
.lecture-chapter
  display flex
  align-items baseline
  gap .8em
  margin 1.7em 0 .9em
  padding .42em .05em .36em
  border-top 2px solid #238a8b
  border-bottom 2px solid #238a8b
  color #197b7c
  font-weight 600

.lecture-chapter-number
  font-family "Iowan Old Style", "Baskerville", "STIX Two Text", serif
  font-size .9em
  white-space nowrap

.lecture-chapter-title
  font-size 1.13em

.lecture-definition,
.lecture-theorem,
.lecture-example,
.lecture-note
  margin 1em 0
  padding .68em 1em .62em
  border: 1px solid #8fc6bd
  background #eff9f1

.lecture-theorem,
.lecture-note
  border-color #9bc8d0
  background #eef8f7

.lecture-example
  background #f7f7ef
  border-color #c9c59b

.lecture-definition p,
.lecture-theorem p,
.lecture-example p,
.lecture-note p
  margin .2em 0
  text-indent 0

.lecture-definition strong,
.lecture-theorem strong,
.lecture-example strong,
.lecture-note strong
  color #123f58

.term-bridge
  margin 1em 0
  padding .62em 1em .58em
  border-left 3px solid #b47a18
  background #fbf8ea
  color #33434a

.term-bridge p
  margin .18em 0
  text-indent 0

.term-bridge strong
  color #6a5312

.svg-figure,
.source-figure
  margin 1.15em 0 1.35em
  text-align center

.svg-figure img,
.source-figure img
  display block
  width 94%
  max-width 980px
  margin 0 auto .48em
  border 1px solid #c8d1cf

.svg-figure figcaption,
.source-figure figcaption
  max-width 90%
  margin 0 auto
  color #6b7270
  font-size .82em
  line-height 1.45

.read-guide
  margin .35em auto 1.2em
  color #5c6968
  font-size .91em
  text-align left

.read-guide strong
  color #315d62

.post-body img[src*="hatcher-ch0-deformation-retraction-excerpt"]
  display block
  width 96%
  margin 1.1em auto .45em
  padding .25em
  border 1px solid #c8d1cf

.post-body img[src*="hatcher-ch0-deformation-retraction-excerpt"] + em
  display block
  margin 0 auto 1em
  color #6b7270
  font-size .82em
  text-align center

.post-body .figure-caption
  margin .1em 0 1em
  color #6b7270
  font-size .82em
  text-align center
  text-indent 0

.algorithm-compare
  display table
  width 100%
  margin 1.2em 0 1.6em
  border-collapse collapse
  font-size .92em

.algorithm-compare th,
.algorithm-compare td
  padding .75em .8em
  border-bottom 1px solid #dfe5e2
  text-align left
  vertical-align top

.algorithm-compare th
  color #263337
  background #f6f8f7
  font-family -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Noto Sans SC", sans-serif
  font-size .86em

@media (max-width: 767px)
  .lecture-chapter
    display block

  .lecture-chapter-number
    display block
    margin-bottom .2em

  .algorithm-compare
    display block
    overflow-x auto
    white-space nowrap
